# Cloudflare R2 (see docs/r2.md). Placeholders only; real values go in an untracked .env.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=hypertrain-data
# Public read URL or custom domain miners use for Range GETs
R2_PUBLIC_BASE=https://data.example.com
# Optional S3-compatible override (MinIO, tests); default https://<account>.r2.cloudflarestorage.com
# R2_ENDPOINT=http://127.0.0.1:9000
