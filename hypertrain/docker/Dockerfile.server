# syntax=docker/dockerfile:1.7
# hypertrain challenge server: Cortex container contract v1 (non-root 65532, read-only root,
# /data the only writable volume). No secret enters any layer: tokens and K_coord are mounted at
# run time under /run/secrets. Base images are pinned by index digest.
#   podman build -f docker/Dockerfile.server -t hypertrain:local .

ARG PYTHON_IMAGE=docker.io/library/python:3.12-slim-bookworm@sha256:392307d22300de8b5986851a12d9176dfc0fc073e65bf6523ebd7dcbeb23564e
ARG UV_IMAGE=ghcr.io/astral-sh/uv:0.12.17@sha256:10787c682e4184e4f290de1171fd4703dc63de99221f10fe1c99002ce7fa9acc

FROM ${UV_IMAGE} AS uv

# ---------------------------------------------------------------------------
FROM ${PYTHON_IMAGE} AS build
COPY --from=uv /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/opt/venv UV_NO_CACHE=1
WORKDIR /src
COPY pyproject.toml uv.lock README.md LICENSE ./
# The server needs torch (the locked CPU wheel, hash-checked) for state-blob hashing and
# honeypot reveals. --frozen installs exactly uv.lock.
RUN uv sync --frozen --no-dev --extra trainer --no-install-project --python /usr/local/bin/python3.12
COPY src ./src
RUN uv sync --frozen --no-dev --extra trainer --no-editable --python /usr/local/bin/python3.12 \
 && /opt/venv/bin/python -c "import hypertrain.challenge.app, torch; assert torch.__version__ == '2.14.0+cpu', torch.__version__"

# ---------------------------------------------------------------------------
FROM ${PYTHON_IMAGE} AS server
ARG VERSION=0.1.0
ARG REVISION=unknown
LABEL org.opencontainers.image.source="https://github.com/CortexLM/hypertrain" \
      org.opencontainers.image.version="${VERSION}" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.title="hypertrain challenge" \
      io.cortex.challenge.slug="hypertrain" \
      io.cortex.challenge.contract="1"
RUN install -d -o 65532 -g 65532 -m 0750 /data
COPY --from=build /opt/venv /opt/venv
ENV PATH=/opt/venv/bin:$PATH \
    HOME=/tmp \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    CHALLENGE_SLUG=hypertrain \
    CHALLENGE_STATE_DIR=/data \
    CHALLENGE_INTERNAL_TOKEN_FILE=/run/secrets/internal.token \
    CHALLENGE_ADMIN_TOKEN_FILE=/run/secrets/admin.token \
    CHALLENGE_WORKER_TOKEN_FILE=/run/secrets/worker.token \
    HYPERTRAIN_COORD_KEY_FILE=/run/secrets/coord.key
USER 65532:65532
WORKDIR /data
VOLUME ["/data"]
EXPOSE 8000
# No HEALTHCHECK: the Cortex supervisor probes /version (liveness) and /health (readiness).
ENTRYPOINT ["uvicorn", "hypertrain.challenge.app:app"]
CMD ["--host", "0.0.0.0", "--port", "8000"]
