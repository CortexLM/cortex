#!/bin/bash
# run-harbor — paid Harbor / custom-Python / script invoke for Baseline / Evaluate.
#
# Every knob is topic data (PROOF_PARAM_* from the signed constraints.params,
# PROOF_TASK_SLICE, PROOF_MODEL_PIN) or pack content; nothing here names a
# benchmark, a task, or a slice.
# Tasks:    filter_tasks.py — params.tasks / task_exclude / n_tasks /
#           max_task_duration_s, task_slice via the pack's slices, pack
#           filter.json allow/deny; else every task. Copied, never the pack.
# Model:    Harbor -m is PROOF_PARAM_MODEL else PROOF_MODEL_PIN; an
#           OpenRouter path fails closed without the openrouter/ prefix.
# Timeouts: params.timeout_multiplier / agent_timeout_multiplier /
#           verifier_timeout_multiplier / env_build_timeout_multiplier →
#           the matching Harbor flags (only when signed); params.exec_timeout_s
#           → PROOF_EXEC_TIMEOUT_S, the default wall clock for a harness
#           environment.exec() call that passes no timeout_sec.
# Trials:   summarize.py — a verifier-measured reward per selected task;
#           params.agent_exception_policy decides what a task the miner's
#           harness crashed on counts as (fail = no measurement, the
#           default; zero = reward 0.0 with the exception in evidence).
# Network:  task_network_mode (default public: agents need the pinned model).
# Harness:  custom Python primary; Harbor BaseAgent, harness.json, run.sh
#           accepted. Topic built-in agent only for baseline with no artefact.
# Runtime:  Docker daemon first (rootful overlay); podman API socket fallback.
# Verifier: pytest injected into filtered-copy images (ensure_verifier_pytest).
# BYOK:     evaluate never falls back to the owner secrets dir.
set -euo pipefail
HERE="$(cd "$(dirname "$0")" && pwd)"
ADAPTOR="$(cd "$HERE/.." && pwd)"
# shellcheck source=../lib.sh
. "$ADAPTOR/lib.sh"

: "${PROOF_OUTPUT_DIR:?}" "${PROOF_WORK_DIR:?}" "${PROOF_JOB:?}"
mkdir -p "$PROOF_OUTPUT_DIR" "$PROOF_WORK_DIR"

case "$PROOF_JOB" in
    baseline | evaluate) ;;
    *) proof_die "run-harbor is for baseline/evaluate, got PROOF_JOB=$PROOF_JOB" ;;
esac

proof_require_tasks
proof_writable_scratch
proof_filter_tasks
proof_enable_agent_network
proof_ensure_verifier
proof_load_inference_key
proof_select_harness >/dev/null
AGENT_ARG="${PROOF_HARBOR_AGENT_ARG:-}"
AGENT_SOURCE="${PROOF_HARBOR_AGENT_SOURCE:-}"
HARNESS_KIND="${PROOF_HARNESS_KIND:?proof_select_harness did not set PROOF_HARNESS_KIND}"

proof_start_container_runtime
proof_export_exec_timeout

jobs_dir="$PROOF_WORK_DIR/harbor-jobs"
mkdir -p "$jobs_dir"
log="$PROOF_WORK_DIR/harbor.run.log"

# What a task the miner's harness raised on counts as (topic data; default
# fail-closed). Shape-checked by the guest before this script runs.
AGENT_EXCEPTION_POLICY="$(printf '%s' "${PROOF_PARAM_AGENT_EXCEPTION_POLICY:-fail}" | tr '[:upper:]' '[:lower:]')"
case "$AGENT_EXCEPTION_POLICY" in
    fail | zero) ;;
    *) proof_die "agent_exception_policy must be fail or zero (got $AGENT_EXCEPTION_POLICY)" ;;
esac

summarize_or_die() {
    local harbor_exit="$1"
    python3 "$HERE/summarize.py" \
        --jobs-dir "$jobs_dir" \
        --log "$log" \
        --output "$PROOF_OUTPUT_DIR/report.json" \
        --harbor-exit "$harbor_exit" \
        --agent "${AGENT_ARG:-$HARNESS_KIND}" \
        --agent-source "$AGENT_SOURCE" \
        --harness-kind "$HARNESS_KIND" \
        --allow-tasks-dir "$PROOF_TASKS" \
        --agent-exception-policy "$AGENT_EXCEPTION_POLICY"
}

if [ "$HARNESS_KIND" = script ]; then
    set +e
    proof_run_script_harness >"$log" 2>&1
    script_exit=$?
    set -e
    proof_persist_work
    # Always summarize Harbor jobs *before* treating script_exit or a
    # miner-authored report as fatal. x0020: Harbor finished (complete
    # trials on disk); miner run.sh TypeError in the postamble was exit 2
    # and the adaptor discarded the score. Miner primary_value is never
    # a paid score — drop their report.json, then write the adaptor's from
    # complete Harbor trials. Fail-closed when the filtered set is
    # incomplete or provenance is untrusted (txt-only / stale snapshot).
    miner_report=0
    if [ -f "$PROOF_OUTPUT_DIR/report.json" ]; then
        rm -f "$PROOF_OUTPUT_DIR/report.json"
        miner_report=1
        echo "rlm_fc_in_guest_harbor: discarded miner-authored report.json; score must come from Harbor verifier trials" >&2
    fi
    rm -f "$PROOF_OUTPUT_DIR/results.json"
    if [ -n "${PROOF_PARAM_RESULTS_PATH:-}" ]; then
        rm -f "$PROOF_OUTPUT_DIR/$PROOF_PARAM_RESULTS_PATH"
    fi
    set +e
    summarize_or_die "$script_exit"
    sum_exit=$?
    set -e
    if [ "$sum_exit" -ne 0 ]; then
        rm -f "$PROOF_OUTPUT_DIR/report.json" "$PROOF_OUTPUT_DIR/results.json"
        if [ "$miner_report" -eq 1 ]; then
            proof_die "script harness wrote report.json; refusing miner-authored primary_value and no measured Harbor trials"
        fi
        if [ "$script_exit" -ne 0 ]; then
            proof_die "script harness exited $script_exit; no complete Harbor trials for the filtered task set"
        fi
        proof_die "no complete Harbor trials for the filtered task set; refusing to invent a primary_value"
    fi
    if [ "$script_exit" -ne 0 ]; then
        echo "rlm_fc_in_guest_harbor: script harness exited ${script_exit}; scored already-measured trials" >&2
    fi
    exit 0
fi

command -v harbor >/dev/null 2>&1 || proof_die "harbor is not on PATH (operator bake must install it)"

# Default Docker env. Topic may set harbor_environment; never pass a Harbor
# no-network policy — rewrite_network already set task.toml to public.
harbor_env="${PROOF_PARAM_HARBOR_ENVIRONMENT:-docker}"
if [ "$harbor_env" = "no-network" ] || [ "$harbor_env" = "none" ]; then
    echo "rlm_fc_in_guest_harbor: ignoring harbor_environment=$harbor_env (agents need network)" >&2
    harbor_env=docker
fi

harbor_cmd=(
    harbor run
    --path "$PROOF_TASKS"
    -a "$AGENT_ARG"
    --jobs-dir "$jobs_dir"
    --n-concurrent "${PROOF_PARAM_N_CONCURRENT:-1}"
    --n-attempts "${PROOF_PARAM_N_ATTEMPTS:-1}"
    --env "$harbor_env"
    --yes
)
# Wall clocks are topic data: each multiplier is passed only when signed,
# so a pack's own task.toml timeouts stand unless the topic scales them.
proof_harbor_timeout_flags harbor_cmd
# Canon model_pin is vendor/model only. Harbor/LiteLLM -m is params.model
# (PROOF_PARAM_MODEL) falling back to the pin. OpenRouter fails closed
# unless the id already has the openrouter/ provider prefix. Inspect
# miner_byok and inference_key_env independently (a non-OpenRouter BYOK
# name must not skip the prefix guard when inference_key_env is
# OPENROUTER_API_KEY).
MODEL="${PROOF_PARAM_MODEL:-${PROOF_MODEL_PIN:-}}"
if [ -n "$MODEL" ]; then
    _openrouter=0
    if proof_csv_has_openrouter "${PROOF_PARAM_MINER_BYOK:-}"; then
        _openrouter=1
    fi
    if proof_csv_has_openrouter "${PROOF_PARAM_INFERENCE_KEY_ENV:-}"; then
        _openrouter=1
    fi
    if [ "$_openrouter" -eq 1 ]; then
        case "$MODEL" in
            openrouter/*) ;;
            *)
                proof_die "OpenRouter Harbor -m needs a provider prefix (params.model=openrouter/...), got a vendor/model pin"
                ;;
        esac
    fi
    unset _openrouter
    export PROOF_HARBOR_MODEL="$MODEL"
    harbor_cmd+=(-m "$MODEL")
    echo "rlm_fc_in_guest_harbor: harbor -m $MODEL" >&2
fi
if [ -n "${PROOF_SEED:-}" ]; then
    export PROOF_SEED
fi

set +e
"${harbor_cmd[@]}" >"$log" 2>&1
harbor_exit=$?
set -e
# Flush before fail so retain-on-fail sees harbor.run.log without e2fsck.
proof_persist_work

# Timeout / kill / nonzero still scores already-complete trials when the
# filtered set is covered (matching verifier_result + reward.txt).
# Fail-closed when n_measured==0, the filtered set is incomplete, or
# provenance is untrusted — never invent a primary_value.
set +e
summarize_or_die "$harbor_exit"
sum_exit=$?
set -e
if [ "$sum_exit" -ne 0 ]; then
    rm -f "$PROOF_OUTPUT_DIR/report.json"
    if [ "$harbor_exit" -ne 0 ]; then
        proof_die_harbor "$harbor_exit" "$log"
    fi
    proof_die "no complete Harbor trials for the filtered task set; refusing to invent a primary_value"
fi
if [ "$harbor_exit" -ne 0 ]; then
    echo "rlm_fc_in_guest_harbor: harbor exited ${harbor_exit}; scored already-measured trials" >&2
fi
