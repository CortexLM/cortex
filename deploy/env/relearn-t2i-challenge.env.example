# operator-managed, never committed to git.
# Relearn T2I challenge orchestration surface.

# Compose requires this file.
# Must match deploy/env/postgres.env on the host (see postgres.env.example).
BASE_DATABASE_URL=postgres://base:base_dev_only_change_me@postgres:5432/base
BASE_NETUID=541

# Q-Judger (Qwen/Qwen-Image-Bench) is the only judge for this challenge.
# The operator sets the endpoint on the host; never commit a value or a host.
#
# These are FORWARDED INTO THE EVAL POD (docs/RELEARN-IMAGE.md § Pod
# environment): a Lium InstanceSpec has no env field, so the pod inherits
# nothing and the image refuses to score without RELEARN_T2I_JUDGE_API_URL.
# Values travel over stdin, never on a command line. Unset URL →
# can_score: false and a 503 before any pod is rented.
#
# RELEARN_T2I_JUDGE_API_KEY therefore reaches hardware the miner pays for.
# Scope and rate-limit that credential, rotate it on suspicion, or leave it
# unset if the pod can reach the judge without auth.
RELEARN_T2I_JUDGE_BACKEND=http_api
RELEARN_T2I_JUDGE_API_URL=
RELEARN_T2I_JUDGE_MODEL=
RELEARN_T2I_JUDGE_API_KEY=

# Cosmos3 backbone on the *eval pod*. First champion:
# RELEARN_ALLOW_MODEL_DOWNLOAD=1 (never committed as 1). Then pin
# RELEARN_T2I_BASE_MODEL_DIR / RELEARN_BASE_MODEL_DIR to the pod path.
# RELEARN_T2I_BASE_MODEL_DIR=
# RELEARN_BASE_MODEL_DIR=
# HF_HOME=
# HF_HUB_CACHE=
# RELEARN_ALLOW_MODEL_DOWNLOAD=
# RELEARN_T2I_ALLOW_MODEL_DOWNLOAD=

# Deterministic offline judge. CI / local ONLY — never a live scoring path.
RELEARN_T2I_FORCE_SIM=false

# Frozen holdout prompt records. Generated off-git with the private salt:
#   cargo run -p xtask -- relearn-t2i-holdout --bench <bench.jsonl> \
#     --salt "$RELEARN_T2I_HOLDOUT_SALT" --size 40 --exclude <each public id> \
#     --out deploy/secrets/relearn-t2i/holdout.json
# The git pin is the CI fixture and is refused for live scoring. Supply the
# private digest (never commit the value) and the operator file.
# RELEARN_T2I_HOLDOUT_COMMITMENT=
# RELEARN_T2I_HOLDOUT_COMMITMENT_FILE=/run/base/relearn-t2i/holdout_commitment
# RELEARN_T2I_HOLDOUT_FILE=/run/base/relearn-t2i/holdout.json

# Operator bearer tokens for POST /v1/admin/promote.
# RELEARN_T2I_ADMIN_TOKENS_FILE=/run/base/relearn-t2i/admin_tokens
