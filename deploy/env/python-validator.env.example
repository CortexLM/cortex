# Pass this file with docker compose --env-file; it contains no private key material.
CORTEX_IMAGE=
BASE_GATEWAY_ENDPOINT=
BASE_NETUID=541
BASE_CHAIN_ENDPOINT=test
BASE_CHAIN_FALLBACK_ENDPOINTS=[]
# Validator hotkey: only the weight-setter role (role-weight-setter.yml) uses it. The
# verify-only validator role needs no wallet.
BASE_WALLET_NAME=
BASE_WALLET_HOTKEY=
BASE_COORDINATION_INTERVAL_SECS=30
# Subnet-specific validator version key. Obtain it from the live subnet; do not guess.
BASE_VERSION_KEY=
BASE_MIN_PEER_SAMPLE=1
BASE_MAX_BLOCK_LAG=256
# Optional absolute overrides; blank values use config and deploy/secrets/wallets.
BASE_VALIDATOR_WALLETS_DIR=
BASE_CONFIG_DIR=
# Verify-only role (role-validator.yml): directory with tls.crt and tls.key only,
# WITHOUT consensus.key.
BASE_VALIDATOR_IDENTITY_DIR=
# Weight-setter (role-weight-setter.yml): its own directory with consensus.key (same
# hotkey as the wallet), tls.crt and tls.key. check_deploy.py refuses the same path for
# both roles.
BASE_WEIGHT_SETTER_IDENTITY_DIR=
# The config directory also contains peers.json: {"<validator pubkey hex>": "https://host:8091"}.
BASE_VALIDATOR_BIND_ADDRESS=
