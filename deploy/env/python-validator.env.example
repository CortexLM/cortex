# Pass this file with docker compose --env-file; it contains no private key material.
CORTEX_IMAGE=
BASE_GATEWAY_ENDPOINT=
BASE_NETUID=541
BASE_CHAIN_ENDPOINT=test
BASE_CHAIN_FALLBACK_ENDPOINTS=[]
BASE_GATEWAY_HOTKEY=
BASE_WALLET_NAME=
BASE_WALLET_HOTKEY=
BASE_COORDINATION_INTERVAL_SECS=30
BASE_CHALLENGES_MIN_VERSION=
BASE_MEASUREMENTS_MIN_VERSION=
# Subnet-specific validator version key. Obtain it from the live subnet; do not guess.
BASE_VERSION_KEY=
BASE_MIN_PEER_SAMPLE=1
# Optional absolute overrides; blank values use config and deploy/secrets/wallets.
BASE_VALIDATOR_WALLETS_DIR=
BASE_TRUST_ROOT_DIR=
# Same hotkey as the wallet; directory holds consensus.key, tls.crt, tls.key.
# Trust directory also contains peers.json: {"<validator pubkey hex>": "https://host:8091"}.
BASE_VALIDATOR_IDENTITY_DIR=
BASE_VALIDATOR_BIND_ADDRESS=
