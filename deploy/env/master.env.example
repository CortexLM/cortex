# Copy to master.env. Materialize private files from the operator's age store.
# Secret files must be readable by container uid 65532 and have mode 0400 or 0600.
# Compose variables (CORTEX_IMAGE and bind address) are supplied with --env-file.
CORTEX_IMAGE=
BASE_GATEWAY_BIND_ADDRESS=
BASE_NETUID=541
BASE_CHAIN_ENDPOINT=test
BASE_EMIT_POLL_SECS=120
BASE_EPOCH_REFRESH_SECS=12
BASE_EPOCH_STALE_SECS=60
BASE_CHALLENGES_MIN_VERSION=1
BASE_MEASUREMENTS_MIN_VERSION=1
# HTTPS public feed; empty remains unavailable and emits no payable Bounty score.
BOUNTY_BACKEND_PUBLIC_URL=
# Dedicated KVM host on the VPC. Empty URL keeps Proof unwired.
PROOF_VM_ORCHESTRATOR_URL=
PROOF_VM_ORCHESTRATOR_TOKEN_FILE=/run/secrets/proof-vm.token
PROOF_VM_ORCHESTRATOR_CA_FILE=/run/secrets/proof-vm-ca.pem
# Fill only from measured bytes and the signed offer; blanks make master boot fail if URL is set.
PROOF_RLM_VM_IMAGE_DIGEST=
# Small-host smoke shape, shared by persistent topic and fresh experiment VMs.
# Match the host caps and capacity; see deploy/README.md before enabling Proof.
PROOF_RLM_VM_VCPUS=1
PROOF_RLM_VM_MEM_MIB=1024
PROOF_RLM_VM_DISK_MIB=16384
PROOF_INFERENCE_OFFER_COMMITMENT=
# Comma-separated ids; every id must also appear in host.toml custom_ids.
PROOF_VM_RUNNER_CUSTOM_IDS=
