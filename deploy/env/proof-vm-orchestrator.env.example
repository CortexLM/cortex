# operator-managed, never committed to git.
# Environment for /etc/proof-vm/orchestrator.env on the host that runs the
# agent (deploy/systemd/proof-vm-orchestrator.service): in production a
# DEDICATED DO droplet on the VPC (g-8vcpu-32gb, nyc1, nested /dev/kvm —
# never the CP droplet); on staging the control-plane droplet itself with
# nested /dev/kvm is an allowed, proven exception (see
# docs/runbooks/proof-vm-orchestrator.md). Not a compose env file; never a
# Lium pod.
#
# Nothing in this file is a secret value. The bearer is a FILE the agent
# re-reads on every request (rotate by rewriting it, no restart). Owner key
# material is a DIRECTORY the agent stages into the RLM VM over vsock; the
# control plane only ever probes its own copy for presence.

# HTTPS listener the control plane's PROOF_VM_ORCHESTRATOR_URL points at.
# A non-loopback bind without TLS cert + key refuses to start.
PROOF_VM_AGENT_BIND=0.0.0.0:8200
PROOF_VM_AGENT_TLS_CERT=/etc/proof-vm/tls.crt
PROOF_VM_AGENT_TLS_KEY=/etc/proof-vm/tls.key
# Every host the CP's PROOF_VM_ORCHESTRATOR_URL may name for this agent: the
# dedicated droplet's VPC IP, a DNS name for it, ... (comma-separated). The
# certificate MUST carry a SAN for each — checked at boot with the CP's own
# validator; a miss exits 1 naming it (the CP's rustls client refuses CN-only
# certificates, curl accepting them proves nothing). REQUIRED with the
# wildcard bind above; with a specific PROOF_VM_AGENT_BIND it defaults to that
# address. Mint the certificate from the same names:
#   deploy/scripts/proof-vm-agent-tls.sh --san <vpc-ip> [--san <hostname>] --write-env
# A docker gateway (172.18.0.1) alone is a colocated-staging artefact, never
# a production value.
# PROOF_VM_AGENT_TLS_SANS=

# Bearer token file (mode 0400, root). The same token goes into the control
# plane's PROOF_VM_ORCHESTRATOR_TOKEN_FILE. Missing/empty = every request 401.
PROOF_VM_AGENT_TOKEN_FILE=/etc/proof-vm/token

# Firecracker + jailer of the SAME release, statically linked (musl).
PROOF_VM_AGENT_FIRECRACKER_BIN=/usr/local/bin/firecracker
PROOF_VM_AGENT_JAILER_BIN=/usr/local/bin/jailer
PROOF_VM_AGENT_CHROOT_BASE=/srv/jailer

# Root filesystem images, one file per pin: sha256-<64 hex>.ext4. The RLM VM
# image digest is chosen by the control plane (PROOF_RLM_VM_IMAGE_DIGEST) and
# must be present here; the agent re-hashes it before every first boot.
PROOF_VM_AGENT_IMAGE_DIR=/var/lib/proof-vm/images

# Guest kernel and its pin. REQUIRED. Take the digest from the kernel you
# actually staged (sha256sum); never invent one.
PROOF_VM_AGENT_KERNEL=/var/lib/proof-vm/vmlinux
# PROOF_VM_AGENT_KERNEL_DIGEST=sha256:

# Miner (sister) guest rootfs pin, present in PROOF_VM_AGENT_IMAGE_DIR.
# REQUIRED. The sister has no network; it speaks the vsock miner protocol
# (proof-vm-proto::guest) and reports flops_used. Never invent one.
# PROOF_VM_AGENT_SISTER_IMAGE_DIGEST=sha256:

# uid/gid the jailer drops Firecracker to (nobody/nogroup by default).
PROOF_VM_AGENT_JAIL_UID=65534
PROOF_VM_AGENT_JAIL_GID=65534

# Sizes. The RLM VM shape (4 vCPU / 8192 MiB) is set by the control plane;
# the sister is sized HERE, never by the RLM.
PROOF_VM_AGENT_SCRATCH_MIB=8192
PROOF_VM_AGENT_SISTER_VCPUS=2
PROOF_VM_AGENT_SISTER_MEM_MIB=4096
PROOF_VM_AGENT_SISTER_SCRATCH_MIB=2048

# Timeouts (seconds). A run is held to its topic deadline inside the guest;
# the host kills it deadline + grace later as a backstop.
PROOF_VM_AGENT_BOOT_TIMEOUT_SECS=120
PROOF_VM_AGENT_DEADLINE_GRACE_SECS=30
PROOF_VM_AGENT_DEFAULT_JOB_TIMEOUT_SECS=3600

# Owner paid-inference key material staged into the RLM VM over vsock (files
# in this directory, by name). Optional. Mode 0400, root. Never in git.
# PROOF_VM_AGENT_OWNER_KEY_DIR=/etc/proof-vm/owner-keys

# Egress the RLM VM may reach, and nothing else: CIDR[:port[/tcp|udp]],
# comma-separated. Typically the RLM judge InferenceOffer origin, the
# artefact locator hosts miners use, and a resolver. EMPTY = NO EGRESS.
# The sister miner guest never has a network interface regardless.
# A ufw / Docker forward chain with policy DROP on this host blocks ALL guest
# egress no matter what this list says: accept the pfc+ TAPs there once
# (runbook § Egress); the agent logs an advisory at every VM boot until it is done.
PROOF_VM_AGENT_UPLINK=eth0
PROOF_VM_AGENT_NET_BASE=172.16.0.0
# PROOF_VM_AGENT_EGRESS_ALLOW=203.0.113.10/32:443,1.1.1.1/32:53/udp

# Where `retain` teardowns move a topic's jail (scratch, console, config).
PROOF_VM_AGENT_RETAIN_DIR=/var/lib/proof-vm/retained

# Experiment VMs (one dedicated microVM per paid job for topics whose signed
# constraints.params select an in-guest runner). Packs a topic pins
# (experiment_pack_digest) live HERE as sha256-<hex>.tar, or under the
# topic's experiment_pack_path; the agent re-hashes the file before every
# boot and stages it into the guest over vsock. Stage the exact tar the topic
# pinned (sha256sum it; never type a digest by hand; never re-tar). Empty
# dir = every experiment topic 503 naming the missing pack. Packs are
# operator files, never in git.
PROOF_VM_AGENT_EXPERIMENT_PACK_DIR=/var/lib/proof-vm/packs
# Ceilings a spec must fit under. Architecte lock: a topic may ask up to
# 8 vCPU / 16 GiB RAM (a silent topic gets the CP's 4 vCPU / 8 GiB default);
# writable disk >= 16 GiB, 32 GiB max by default — raise it when the metal
# has more. Over = 400 bad_spec, never a clamp. Must agree with the control
# plane's PROOF_EXPERIMENT_VM_MAX_*.
PROOF_VM_AGENT_EXPERIMENT_MAX_VCPUS=8
PROOF_VM_AGENT_EXPERIMENT_MAX_MEM_MIB=16384
PROOF_VM_AGENT_EXPERIMENT_MAX_DISK_MIB=32768
# How many experiment VMs run at once on this host (each may be as large as
# the ceilings above; parallel experiments are parallel VMs, never containers
# sharing one VM). Beyond it a create answers 503 capacity until one
# finishes. 0 disables experiment VMs; topic VMs are unaffected.
PROOF_VM_AGENT_MAX_EXPERIMENT_VMS=2
# Seconds the guest may take to verify + unpack a staged pack.
PROOF_VM_AGENT_PACK_STAGE_TIMEOUT_SECS=600
