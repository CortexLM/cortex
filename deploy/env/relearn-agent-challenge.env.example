# operator-managed, never committed to git.
# Relearn Agent challenge orchestration surface (`relearn-agent`, :8099).

# Compose requires this file.
# Must match deploy/env/postgres.env on the host (see postgres.env.example).
BASE_DATABASE_URL=postgres://base:base_dev_only_change_me@postgres:5432/base
BASE_NETUID=541

# Sim is CI/local only and is never a fallback. On a live host the service
# needs all three of: a sha256 eval_image_digest in
# config/relearn-agent-pin.toml, a wired harvest (LIUM_API_KEY +
# LIUM_SSH_PUBLIC_KEY_FILE below), and a champion baseline. Until it has them
# every submission answers 503. Check GET /v1/status → can_score,
# live_harvest_wired, champion_baseline_recorded.
RELEARN_AGENT_FORCE_SIM=false

# Teacher / judge HTTP API. Operator sets these on the host. Never commit values.
#
# FORWARDED INTO THE EVAL POD (docs/RELEARN-AGENT.md § Pod environment).
# Unset RELEARN_TEACHER_API_URL → can_score: false and a 503 before any pod
# is rented. The key, if set, reaches hardware the miner pays for — scope
# and rate-limit it, or leave it unset if the pod can reach the teacher
# without auth.
RELEARN_TEACHER_API_URL=
RELEARN_TEACHER_MODEL=
RELEARN_TEACHER_API_KEY=

# Qwen backbone on the *eval pod*. Same contract as relearn: first champion
# sets RELEARN_ALLOW_MODEL_DOWNLOAD=1 (never committed as 1); then pin
# RELEARN_BASE_MODEL_DIR to the pod cache path. Unset both → no rent.
# RELEARN_BASE_MODEL_DIR=
# HF_HOME=
# HF_HUB_CACHE=
# RELEARN_ALLOW_MODEL_DOWNLOAD=

# The miner pays for the eval pod; this key is the master's Lium account used
# to provision and terminate it. Never logged, never echoed on /v1/status.
# LIUM_API_KEY=
# LIUM_API_BASE_URL=
# Without the master public key the pod boots unreachable, so the harvest is
# not wired and submissions refuse.
# LIUM_SSH_PUBLIC_KEY_FILE=/run/base/lium/lium_ssh_ed25519.pub

# Frozen holdout episodes. Generated off-git with the private salt:
#   cargo run -p xtask -- relearn-agent-holdout --catalog <catalogue.json> \
#     --salt "$RELEARN_AGENT_HOLDOUT_SALT" --size 120 --exclude <each public id> \
#     --out deploy/secrets/relearn-agent/episodes.json
# Verified against holdout_commitment in config/relearn-agent-pin.toml at boot.
# A mismatch means submissions 503 rather than scoring the published split.
# RELEARN_AGENT_HOLDOUT_FILE=/run/base/relearn-agent/episodes.json

# Base checkpoint measured by the pinned eval image, installed once by the
# operator. Every gate — trace replay, tool ablation, observation shuffle, the
# capability canary — compares against it, and it is verified against the pin's
# eval_image_digest + holdout_commitment at boot. Never commit it.
# RELEARN_AGENT_BASE_CHAMPION_FILE=/run/base/relearn-agent/base_champion.json

# Operator bearer tokens for POST /v1/admin/promote.
# RELEARN_AGENT_ADMIN_TOKENS_FILE=/run/base/relearn-agent/admin_tokens

# Seconds the eval image gets to replay one artifact (three arms, so longer
# than the single-pass text challenge).
# RELEARN_AGENT_EVAL_TIMEOUT_SECS=5400
