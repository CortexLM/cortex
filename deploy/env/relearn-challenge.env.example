# operator-managed, never committed to git.
# Relearn challenge orchestration surface.

# Compose requires this file.
# Must match deploy/env/postgres.env on the host (see postgres.env.example).
BASE_DATABASE_URL=postgres://base:base_dev_only_change_me@postgres:5432/base
BASE_NETUID=541

# Teacher HTTP API (judge only). Operator sets these on the host. Never commit values.
#
# These are FORWARDED INTO THE EVAL POD (docs/RELEARN.md § Pod environment): a
# Lium InstanceSpec has no env field, so the pod inherits nothing and the image
# refuses to score without RELEARN_TEACHER_API_URL. Values travel over stdin,
# never on a command line. Unset URL → can_score: false and a 503 before any
# pod is rented.
#
# RELEARN_TEACHER_API_KEY therefore reaches hardware the miner pays for. Scope
# and rate-limit that credential, rotate it on suspicion, or leave it unset if
# the pod can reach the teacher without auth.
RELEARN_TEACHER_BACKEND=http_api
RELEARN_TEACHER_API_URL=
RELEARN_TEACHER_MODEL=
RELEARN_TEACHER_API_KEY=

# Qwen backbone on the *eval pod*, not the teacher host. The CUDA image does
# not bake 27B. First champion harvest: set RELEARN_ALLOW_MODEL_DOWNLOAD=1
# (never committed as 1). After Lium keeps a cache, pin
# RELEARN_BASE_MODEL_DIR to that pod path (e.g. /models/base) and unset
# ALLOW_DOWNLOAD. Names only in git. Unset both → can_score: false, no rent.
# RELEARN_BASE_MODEL_DIR=
# HF_HOME=
# HF_HUB_CACHE=
# RELEARN_ALLOW_MODEL_DOWNLOAD=

# Teacher weights directory for vLLM. Never a Hugging Face repo id.
# RELEARN_TEACHER_LOCAL_DIR=/models/glm-5.3-nvfp4

# Deterministic offline eval. CI / local ONLY — never a live scoring path.
# Leave false: without it, and without a sha256 eval_image_digest in
# config/relearn-pin.toml, POST /v1/submissions answers 503 rather than
# returning simulated scores. /v1/status reports the resolved eval_backend.
RELEARN_FORCE_SIM=false

# Frozen holdout records. Never commit. The git pin is the CI fixture and is
# refused for live scoring. Supply the private digest (never commit the value)
# and the operator file. Missing/mismatch → 503.
# RELEARN_HOLDOUT_COMMITMENT=
# RELEARN_HOLDOUT_COMMITMENT_FILE=/run/base/relearn/holdout_commitment
# RELEARN_HOLDOUT_FILE=/run/base/relearn/holdout.json
#
# Persisted submissions / scores / champion. Corrupt file → refuse to serve.
# RELEARN_STATE_FILE=/run/base/relearn/state.json
#
#   cargo run -p xtask -- relearn-holdout --catalog <catalog.json> \
#     --salt "$RELEARN_HOLDOUT_SALT" --size 120 --exclude <each public id> \
#     --out deploy/secrets/relearn/holdout.json

# Live harvest (digest-pinned eval image on a Lium pod). The miner pays, so
# the key comes from the operator only for the boot baseline measurement.
# Never commit. Without both of these the harvest is not wired and a live host
# 503s: docs/RELEARN.md § Eval image contract.
# LIUM_API_KEY=
# LIUM_SSH_PUBLIC_KEY_FILE=/run/base/relearn/lium_ssh_ed25519.pub
# LIUM_SSH_PRIVATE_KEY=/run/base/relearn/lium_ssh_ed25519
# Point at a stand-in provider in staging instead of spending real money.
# LIUM_API_BASE_URL=
# Seconds the eval image gets to score one artifact on the pod.
RELEARN_EVAL_TIMEOUT_SECS=3600

# Champion baseline: base_model measured by the pinned eval image. Never
# commit. Required on a live host — every gate compares against it, so without
# it submissions 503 with "no champion baseline recorded". Verified at boot
# against eval_image_digest + holdout_commitment in config/relearn-pin.toml.
# Format: docs/RELEARN.md § Champion baseline.
# RELEARN_BASE_CHAMPION_FILE=/run/base/relearn/base-champion.json

# Operator bearer tokens for POST /v1/admin/promote.
# RELEARN_ADMIN_TOKENS_FILE=/run/base/relearn/admin_tokens
