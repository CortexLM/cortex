[Unit]
Description=Cortex Python Proof Firecracker host
After=network-online.target
Wants=network-online.target
ConditionPathExists=/dev/kvm

[Service]
Type=simple
# The host configures network namespaces and starts jailer, which drops guest privileges.
User=root
UMask=0077
StateDirectory=proof
StateDirectoryMode=0700
WorkingDirectory=/var/lib/proof
ExecStart=/opt/base/venv/bin/cortex vm-host --config /etc/proof-vm/host.toml
Restart=on-failure
RestartSec=5
TimeoutStopSec=7500
KillMode=control-group
LimitNOFILE=65536
Delegate=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectKernelTunables=no
ProtectControlGroups=no
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectHostname=yes
ProtectClock=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
SystemCallArchitectures=native
ReadWritePaths=/var/lib/proof /run
ReadOnlyPaths=/etc/proof-vm /opt/base/venv /usr/local/bin/firecracker /usr/local/bin/jailer
CapabilityBoundingSet=CAP_SYS_ADMIN CAP_SYS_CHROOT CAP_MKNOD CAP_NET_ADMIN CAP_SETUID CAP_SETGID CAP_CHOWN CAP_DAC_OVERRIDE CAP_FOWNER CAP_KILL CAP_SYS_RESOURCE
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
