#!/usr/bin/env bash
# Complete offline gate. It never contacts OpenRouter, rents compute, or boots KVM.
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
cd "$root"
# Tests create foreign repositories; discard this worktree's inherited Git context.
unset $(git rev-parse --local-env-vars)
if ! command -v uv >/dev/null 2>&1; then
  echo "pre-push: uv is required" >&2
  exit 1
fi
export UV_CACHE_DIR="${UV_CACHE_DIR:-$root/.cache/uv}"
uv run --no-sync ruff format --check src tests scripts
uv run --no-sync ruff check src tests scripts
uv run --no-sync mypy
uv run --no-sync pytest -m 'not live'
uv run --no-sync python scripts/check_repo.py --final
uv run --no-sync python scripts/check_deploy.py --check-examples
